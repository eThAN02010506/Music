MUSIC_INSIGHT_WORKSPACE_DIR=.music_insight
# Independent limits: transport bytes are capped before multipart parsing;
# the stored upload is then duration-probed and enforced again while decoding.
MUSIC_INSIGHT_MAX_UPLOAD_MB=128
MUSIC_INSIGHT_MAX_AUDIO_MINUTES=20
MUSIC_INSIGHT_ASSET_GC_GRACE_HOURS=24
# memory 模式下属于一个 API 进程；redis 模式下由 Redis 原子地全局执行。
MUSIC_INSIGHT_MAX_ACTIVE_JOBS=8
MUSIC_INSIGHT_MAX_ACTIVE_JOBS_PER_USER=3
# 默认无需 Redis。横向扩展时改为 redis，并把 shared audio 挂载到每个
# API/Worker 上完全相同的绝对路径。
MUSIC_INSIGHT_JOB_BACKEND=memory
# MUSIC_INSIGHT_SHARED_AUDIO_DIR=/srv/music-insight-audio
# MUSIC_INSIGHT_REDIS_URL=redis://127.0.0.1:6379/0
# MUSIC_INSIGHT_REDIS_KEY_PREFIX=music-insight
# MUSIC_INSIGHT_REDIS_JOB_TTL_SECONDS=604800
# MUSIC_INSIGHT_CELERY_QUEUE_NAME=music-insight.analysis
# 必须长于任何一次分析的最长可能运行时间。
# MUSIC_INSIGHT_CELERY_VISIBILITY_TIMEOUT_SECONDS=14400
# Worker 进程数；共享 8004 时建议从 1 开始压测。
# MUSIC_INSIGHT_WORKER_CONCURRENCY=1
# Direct analysis/retry/scoring and multipart admission are independently
# bounded. A two-file singing comparison consumes two upload units.
MUSIC_INSIGHT_MAX_DIRECT_WORK=2
MUSIC_INSIGHT_MAX_DIRECT_WORK_PER_USER=1
MUSIC_INSIGHT_MAX_UPLOAD_UNITS=2
# scrypt uses about 32 MiB per active calculation with the configured profile.
MUSIC_INSIGHT_AUTH_KDF_MAX_CONCURRENCY=4
MUSIC_INSIGHT_DSP_MAX_CONCURRENCY=2
MUSIC_INSIGHT_OMNI_ENDPOINT=http://192.168.1.97:8004
MUSIC_INSIGHT_OMNI_COMPLETIONS_PATH=/v1/chat/completions
MUSIC_INSIGHT_OMNI_MODELS_PATH=/v1/models
# Optional explicit model ID; leave unset to use the service's first model.
# MUSIC_INSIGHT_OMNI_MODEL=
MUSIC_INSIGHT_OMNI_CHUNK_SECONDS=30
MUSIC_INSIGHT_OMNI_CHUNK_OVERLAP_SECONDS=1.5
MUSIC_INSIGHT_OMNI_MAX_CONCURRENCY=1
# Optional independent timestamped lyric verification. Disabled by default so
# a fresh install does not depend on a second model service.
MUSIC_INSIGHT_ASR_VERIFIER_ENABLED=false
MUSIC_INSIGHT_ASR_VERIFIER_ENDPOINT=http://192.168.1.97:8003
MUSIC_INSIGHT_ASR_VERIFIER_TRANSCRIPTIONS_PATH=/v1/audio/transcriptions
MUSIC_INSIGHT_ASR_VERIFIER_DIALECT=crisp_asr
# openai_whisper requires a model ID; crisp_asr may omit it.
# MUSIC_INSIGHT_ASR_VERIFIER_MODEL=whisper-1
# MUSIC_INSIGHT_ASR_VERIFIER_API_KEY=
MUSIC_INSIGHT_ASR_VERIFIER_TIMEOUT_SECONDS=600
# CrispASR-only extension. false omits the non-standard form field.
MUSIC_INSIGHT_ASR_VERIFIER_VAD=false
MUSIC_INSIGHT_ASR_VERIFIER_MAX_CONCURRENCY=1
# Comni /ws/chat uses shorter chunks and separate bounded WebSocket timeouts.
MUSIC_INSIGHT_COMNI_CHUNK_SECONDS=15
MUSIC_INSIGHT_COMNI_OPEN_TIMEOUT_SECONDS=10
MUSIC_INSIGHT_COMNI_FIRST_EVENT_TIMEOUT_SECONDS=600
MUSIC_INSIGHT_COMNI_IDLE_TIMEOUT_SECONDS=600
MUSIC_INSIGHT_COMNI_REQUEST_TIMEOUT_SECONDS=600
MUSIC_INSIGHT_COMNI_MAX_MESSAGE_MB=8
MUSIC_INSIGHT_LOCAL_MODEL_ROOT=src/model
MUSIC_INSIGHT_LOCAL_OMNI_ENDPOINT=http://127.0.0.1:8011
MUSIC_INSIGHT_LOCAL_LLAMA_SERVER=llama-server
# Comma-separated exact browser origins, including scheme and port.
MUSIC_INSIGHT_WEB_ORIGINS=http://127.0.0.1:5174
